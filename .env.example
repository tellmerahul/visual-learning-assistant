# Option A — client-side (dev only; key is visible in the browser)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# Option B — Vercel serverless proxy (recommended for production)
# REACT_APP_USE_GEMINI_PROXY=true
# Set GEMINI_API_KEY in Vercel project env (not REACT_APP_*)

# Optional: API base when not same origin
# REACT_APP_API_BASE=